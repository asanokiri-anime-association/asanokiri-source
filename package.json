{
    "name": "asanokiri",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "check:content": "node scripts/content.ts",
        "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
        "test": "node --test tests/*.test.ts",
        "format": "prettier --write .",
        "check:format": "prettier --check ."
    },
    "dependencies": {
        "@fontsource-variable/noto-serif-sc": "5.3.0",
        "@fontsource/cormorant-garamond": "5.3.0",
        "@lucide/vue": "1.51.0",
        "vue": "3.5.43",
        "vue-router": "5.3.1"
    },
    "devDependencies": {
        "@types/js-yaml": "4.0.9",
        "@types/markdown-it": "14.2.0",
        "@types/node": "24.19.1",
        "@vitejs/plugin-vue": "6.0.9",
        "@vue/tsconfig": "0.9.1",
        "js-yaml": "5.4.2",
        "markdown-it": "15.0.2",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "uqr": "0.1.3",
        "vite": "8.3.2",
        "vue-tsc": "3.3.12",
        "zod": "4.6.5"
    }
}
